<Window x:Class="Microsoft.Sarif.Viewer.Views.CodeQLInstallHelper"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Microsoft.Sarif.Viewer.Views"
        mc:Ignorable="d"
        Title="CodeQL Error" Height="269" Width="497" WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid HorizontalAlignment="Center" Width="437" Margin="0,10,0,-6">
        <TextBlock
                TextWrapping="Wrap" HorizontalAlignment="Right" Width="390" Height="65" VerticalAlignment="Top" Margin="0,10,37,0" 
                ><Run Text="CodeQL not found! Click the 'Install CodeQL' button to allow the extension to install CodeQL to the default path specified below."/><LineBreak/><Run/><LineBreak/>
            <Run Text="Note: If installing CodeQL to a non-default location, add it to your PATH environment variable."/><LineBreak/><Run/><LineBreak/><Run Text="Get more information at aka.ms/wddst"/></TextBlock>
        <Button Name="buttonInstall" Click="ButtonInstall_Click"
                VerticalAlignment="Bottom" Height="23"  Content="Install CodeQL" Margin="0,0,99,24" HorizontalAlignment="Right" Width="106" />
        <Button Name="buttonCancel" Click="ButtonCancel_Click" 
            VerticalAlignment="Bottom" Height="23" Content="Cancel" Margin="0,0,10,24" HorizontalAlignment="Right" Width="74" />
        <TextBox x:Name="___TextBoxPath_" HorizontalAlignment="Right" Margin="0,102,102,0" TextWrapping="Wrap" Text="C:\codeql-home\" VerticalAlignment="Top" Width="253" Height="24"/>
        <TextBox x:Name="___TextBoxVersion_" HorizontalAlignment="Left" Margin="82,130,0,0" TextWrapping="Wrap" Text="2.21.0" VerticalAlignment="Top" Width="76" Height="23"/>
        <TextBlock
            TextWrapping="Wrap" HorizontalAlignment="Right" Width="67" Height="16" VerticalAlignment="Top" Margin="0,106,360,0" 
                Text="Install Path:" 
                />
        <TextBlock
            TextWrapping="Wrap" Margin="0,134,383,63" 
            Text="Version:" HorizontalAlignment="Right" Width="44" 
                />
        <CheckBox x:Name="AddToPathCheckBox" Content="Add to PATH" HorizontalAlignment="Left" Margin="340,106,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
