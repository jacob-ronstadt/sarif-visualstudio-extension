<Window x:Class="Microsoft.Sarif.Viewer.Views.CodeQLPackInstallHelper"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Microsoft.Sarif.Viewer.Views"
        mc:Ignorable="d"
        Title="CodeQL Error" Height="269" Width="497" WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid HorizontalAlignment="Center" Width="437" Margin="0,10,0,-6">
        <TextBlock
                TextWrapping="Wrap" HorizontalAlignment="Right" Width="390" Height="65" VerticalAlignment="Top" Margin="0,10,37,0" 
                ><Run Text="Missing required CodeQL packs! Click the 'Install' button to allow the extension to install the selected CodeQL packs and their dependencies. "/><LineBreak/><Run/><LineBreak/><Run Text="Get more information at aka.ms/wddst"/></TextBlock>
        <Button Name="buttonInstall" Click="ButtonInstall_Click"
                VerticalAlignment="Bottom" Height="23"  Content="Install" Margin="0,0,99,24" HorizontalAlignment="Right" Width="106" />
        <Button Name="buttonCancel" Click="ButtonCancel_Click" 
            VerticalAlignment="Bottom" Height="23" Content="Cancel" Margin="0,0,10,24" HorizontalAlignment="Right" Width="74" />
        <CheckBox x:Name="mwdCheckBox" Content="microsoft/windows-drivers" HorizontalAlignment="Left" Margin="10,108,0,0" VerticalAlignment="Top" Checked="CheckBox_Checked"/>
        <CheckBox x:Name="mcqCheckBox" Content="microsoft/cpp-queries" HorizontalAlignment="Left" Margin="10,128,0,0" VerticalAlignment="Top"/>
        <CheckBox x:Name="ccaCheckBox" Content="codeql/cpp-all" HorizontalAlignment="Left" Margin="10,148,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
