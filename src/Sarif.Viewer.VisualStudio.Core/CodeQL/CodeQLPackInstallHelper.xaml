<Window x:Class="Microsoft.Sarif.Viewer.Views.CodeQLPackInstallHelper"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Microsoft.Sarif.Viewer.Views"
        mc:Ignorable="d"
        Title="CodeQL Packs" Height="317" Width="272" WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid HorizontalAlignment="Center" Width="237" Margin="0,10,0,1">
        <Button Name="buttonInstall" Click="ButtonInstall_Click"
                VerticalAlignment="Bottom" Height="23"  Content="Install" Margin="0,0,118,10" HorizontalAlignment="Right" Width="106" />
        <Button Name="buttonCancel" Click="ButtonCancel_Click" 
            VerticalAlignment="Bottom" Height="23" Content="Cancel" Margin="0,0,10,10" HorizontalAlignment="Right" Width="74" />
        <CheckBox x:Name="windowsDrivers" Content="Windows Drivers" HorizontalAlignment="Left" Margin="10,170,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="cppCheckBox" Content="C++" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="csharpCheckBox" Content="C#" HorizontalAlignment="Left" Margin="10,30,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="goCheckBox" Content="Go" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="javaCheckBox" Content="Java" HorizontalAlignment="Left" Margin="10,50,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="jsCheckBox" Content="JavaScript" HorizontalAlignment="Left" Margin="10,130,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="pythohCheckBox" Content="Python" HorizontalAlignment="Left" Margin="10,90,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="rubyCheckBox" Content="Ruby" HorizontalAlignment="Left" Margin="10,110,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>
        <CheckBox x:Name="swiftCheckBox" Content="Swift" HorizontalAlignment="Left" Margin="10,150,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked"/>

    </Grid>
</Window>
