<Window x:Class="Microsoft.Sarif.Viewer.Views.CodeQLPackInstallHelper"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Microsoft.Sarif.Viewer.Views"
        mc:Ignorable="d"
        Title="CodeQL Packs" Height="317" Width="272" WindowStyle="ToolWindow" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen">
    <Grid HorizontalAlignment="Center" Width="237" Margin="0,10,0,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="220*"/>
        </Grid.ColumnDefinitions>
        <Button Name="buttonInstall" Click="ButtonInstall_Click" IsEnabled="False"
                VerticalAlignment="Bottom" Height="23"  Content="Install" Margin="0,0,155,10" HorizontalAlignment="Right" Width="74" Grid.ColumnSpan="2" />
        <Button Name="buttonCancel" Click="ButtonCancel_Click" 
            VerticalAlignment="Bottom" Height="23" Content="Cancel" Margin="0,0,10,10" HorizontalAlignment="Right" Width="74" Grid.Column="1" />
        <CheckBox x:Name="windowsDrivers" Content="Windows Drivers" HorizontalAlignment="Left" Margin="10,201,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="cppCheckBox" Content="C++" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="csharpCheckBox" Content="C#" HorizontalAlignment="Left" Margin="10,61,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="goCheckBox" Content="Go" HorizontalAlignment="Left" Margin="10,101,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="javaCheckBox" Content="Java" HorizontalAlignment="Left" Margin="10,81,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="jsCheckBox" Content="JavaScript" HorizontalAlignment="Left" Margin="10,161,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="pythohCheckBox" Content="Python" HorizontalAlignment="Left" Margin="10,121,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="rubyCheckBox" Content="Ruby" HorizontalAlignment="Left" Margin="10,141,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="swiftCheckBox" Content="Swift" HorizontalAlignment="Left" Margin="10,181,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <CheckBox x:Name="otherCheckBox" Content="" HorizontalAlignment="Left" Margin="10,221,0,0" VerticalAlignment="Top" Checked="LanguagePack_Checked" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Margin="9,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="20" Width="218" Grid.ColumnSpan="2"><Run FontWeight="Bold" Text="Select CodeQL packs to install"/></TextBlock>
        <TextBox Grid.Column="1" HorizontalAlignment="Left" Margin="13,220,0,0" TextWrapping="Wrap" Text="Other" VerticalAlignment="Top" Width="120" />

    </Grid>
</Window>
